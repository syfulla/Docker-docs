			"parentId": "page:page",
			"index": "aZlgE",
			"typeName": "shape"
		},
		{
			"x": -222.91145459798156,
			"y": 3579.43647032321,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:zN_iiTqa1ZlCEbWXf2gOu",
			"type": "text",
			"props": {
				"color": "black",
				"size": "m",
				"w": 1987.9375,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Volumes and Bid mounts"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "How data is persisted in Docker?."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Let's say you were to run a MySQL container, when database and tables are created the data files are stored in /var/lib/mysql inside the container the docker"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "container has it's own isolated file system, and any changes to any files happen within the container. Let's assume you dump a lot of data into the database"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "and if you were to delete or remove the container all your dumped data get's deleted as well"
								}
							]
						}
					]
				}
			},
