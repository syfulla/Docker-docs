			"parentId": "page:kevi_8ziZRBjXGF6dbUmV",
			"index": "aIrsI",
			"typeName": "shape"
		},
		{
			"x": 81.09014730337991,
			"y": 1120.5657826668587,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:blvbBFb0qU4t-whHCPOo5",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1038.84375,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The above command will create an image locally and you can push the image to the public docker hub registry"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker push mmumshad/my-custom-app"
								},
								{
									"type": "text",
									"text": " "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						}
					]
				}
			},
			"parentId": "page:LCyPAPSZw0YbNqFVstewh",
			"index": "a7GKf",
			"typeName": "shape"
		},
		{
			"x": 534.5584377463204,
			"y": 4971.385907444323,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:gVaKVA6ELMS-I_Ycrf3o0",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 113.65625,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "With Docker"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b1Q9zJ",
			"typeName": "shape"
		},
		{
			"x": -225.26471896691967,
			"y": 224.98552666199862,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:Fdv7SydVfq3LlvTHWjpCq",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1518.0249610400915,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Now if we don't want an exited container lying around and consuming space we can get rid of it by using "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker rm <container Name> "
								},
								{
									"type": "text",
									"text": "if it prints the name back we are good"
								}
							]
						}
					]
				}
			},
			"parentId": "page:kevi_8ziZRBjXGF6dbUmV",
			"index": "aMOg6",
			"typeName": "shape"
		},
		{
			"x": -229.9190050361375,
			"y": 537.5417071687185,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:FXKxnO9dxfVu7R0SZFi7B",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1975.2526130972303,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1.0055854339073034,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Suppose you were to run docker container from an Ubuntu image, you run \"ducker run Ubuntu\" command it runs an instance of the ubuntu image and exits immediately."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "if you were to list the running containers, you wouldn't see the container running. if you list all containers, including those that are stopped, you will see that the new container "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "you ran is in exited state. Unlike Virtual machines, containers are not meant to host on operating system. Containers are meant to run a specific taks or process, such as to host an instance of "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "a web server or an application server or a database or simply to carry out some kind of computation or analysis task. Once the task is complete, the container exits. A container only lives as"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "long as the process inside it is alive. if the web service inside the container is stopped or crashed, then the container exits. This is why when you run a container from an Ubuntu image it stops "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "immediately, because Ubuntu is just an image of an operating system that is used as the base image for other applications. There is no process or application running in it by default. Suppose if"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "you want to run a container in a sleep mode you can use \""
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run ubuntu sleep 5"
								},
								{
									"type": "text",
									"text": "\" after which the sleep command exits and the container stops."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Now if you want to execute a command on a running container and would like to see a particular file inside a container we can use "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker exec 538d cat /etc/hosts "
								},
								{
									"type": "text",
									"text": "this is how we debug "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "change a config, check a log, run a quick query. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Suppose, let's consider you are running a web application name codecloud by using the command "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run codecloud "
								},
								{
									"type": "text",
									"text": "it runs on the port which ever we configured and when you run a docker"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "run command like this, it runs in the foreground or in attached mode, meaning you will be attached to the console or the standard out of the docker container, and you will see the output of the "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "web service on your screen. you won't be able to do anything else on this console other than view the output until this docker container sotps. it won't respond to your inputs. press the control C"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "combination to stop the container exists, and you get back to your prompt. Another option is to run the docker container in detached mode by providing the das D option, "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -d codecloud"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "this will run the docker container in the background, and you will be back to your prompt immediately. The container will continue to run in the backend. Now if you would like to attach bac to the "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "running container later run the docker attach command "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker attach a043d"
								},
								{
									"type": "text",
									"text": " and specify the docker container ID. If you are specifying the ID of a container in any docker command, you can "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "simply provide the first few characters alone just emough so it is different from the other container Id's on the host."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "To clear all the stopped containers, all networks not used by at least one container, all dangling images, unused build cache you can use "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker system prune"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "To name a container of our choise we can use "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run --name <name> <container>"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Tags:"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "we can run a docker container simply by "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run redis "
								},
								{
									"type": "text",
									"text": "which will gives us the latest version of Redis currently version 8.6.1 but what if we want to run another version like 7.4?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "You specify the version with a colon such as 7.4 this is called a tag "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run redis:7.4. "
								},
								{
									"type": "text",
									"text": "If you don't specify the version docker runs the latest version of redis docker considers default tags"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "to be the latest"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Note: In production you should always pin to a specific tag, like"
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": " docker run redis:7.4"
								},
								{
									"type": "text",
									"text": " not like "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run redis"
								},
								{
									"type": "text",
									"text": " because what if the author pushed something which will break our changes to the latest"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "and we ended up using that latest"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Interactive Mode"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "let's consider we have a simple prompt application which will be like below"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "welcome! Please enter your name: Syfulla"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Hello and welcome Syfulla"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "The above application is taking an input which is name and prints an output along with the imput now if we dockerize this application, it wonldn't wait for the prompt it just prints whetever the application"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "is supposed to print on standerd out. That's because by default, docker container does not listen to standard input even though you're attached to it's console. It runs in a non-interactive mode. if you'd like"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "to provide your input, you must map the standard input of your host to the docker container using the dash i parameter for the interactive mode"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run kodekloud/simple-prompt-docker"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Hello and Welcome!"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -i kodekloud/simple-prompt-docker"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Syfulla"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Hello and welcome Syfulla!"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Now the Prompt is missing, even though it seems to have accepted our input. That's because the application prompts on the terminal and we have not attached to the container's terminal.. For this, use the"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "dash t option as well. The dash t stands for pseudo terminal. So with the combination of dash i and dash t, we are now attached to the terminal as well"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -it kodekloud/simple-prompt-docker"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Welcome! Please enter your name: Syfulla"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Hello and Welcome Syfulla!"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "you can use only -i or -t alone when you have use case like if you just want standard input connected so the container can read the data but don't need terminal because i'm not typing anything and you can"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "use -t alone when you want colored output or progress bars and I don't need to type anything. Programs check whether they're attached to a terminal to decide whether to emit colors and pretty formatting."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "With -t programs thinks it's talking to real terminal"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "-i alone STDIN in, no TTY  "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -i postgres psql "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "-t alone TTY, no STDIN(coloured output/progress bars)  "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -t alpins --color=always"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "Port Mapping"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Let's take an example of a simple web application in a docker container on my Docker host. The underlying host where Docker is installed is called Docker host or docker engine. when we run the containerized"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "web application, it runs and we can see that the server is running. But how does a user actually access our application?. our application is listening on port 5000, so we could access it on port 5000. But what"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "IP do we use to reach it from a web browser?. There are two options. One is to use the IP of the DOcker Container. Every Docker Container gets an IP assigned by default. But remember, this is an internal IP"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "and is only accessible within the Docker host. So, if you open a browser from within the Docker host, you can go to that container IP on port 5000. Bust since this is an internal IP, users otside the Docker host "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "cannot reach it. For that we use the IP of the Docker host. to connect the IP of the docker host to the container we must map it first inside the docker container to a free port on the docker host."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "For example, if I want users to reach our application through port 80 on our Docker host we map port 80 of the host to port 5000 on the container using the P parameter and so the user can now reach our "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "application by going to that host IP on port 80 and all traffic on port 80 of docker host gets routed to port 5000 inside the container. Similarly, we can map multiple instances of our application to different "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "ports on the docker host or instances of different applications on different ports"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -p 80:5000 kodekloud/webapp"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -p 8000:5000 kodekloud/webapp"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -p 8001:5000 kodekloud/webapp"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -p 3306:3306 mysql"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "docker run -p 8306:3306 mysql"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "you cannot map to the same port on the Docker host more than once."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						}
					]
				}
			},
			"parentId": "page:kevi_8ziZRBjXGF6dbUmV",
			"index": "aTicX",
			"typeName": "shape"
		},
