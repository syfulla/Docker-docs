		},
		{
			"x": 371.1264489279622,
			"y": 1056.1602573028306,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:ie8cZ1V5fPaW8ca9XXW1c",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 114.1875,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
