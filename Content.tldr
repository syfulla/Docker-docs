		{
			"x": 416.16089829138195,
			"y": 2508.5273746437733,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:mStjQlASKpIrnZArzICUj",
			"type": "geo",
			"props": {
				"w": 497.656233067,
				"h": 105.94637586349972,
				"geo": "rectangle",
				"dash": "draw",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
